# SCADA Generator — переменные окружения.
# Скопируйте в .env и укажите реальные значения. Файл .env не коммитится.

# PostgreSQL (архив истории, алармов и ML-инсайтов)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scada_generator
DB_USER=scada
DB_PASSWORD=change_me

# Токен оператора: если задан, квитирование, запись уставок и управление
# ML требуют заголовка X-API-Token. Обязателен, если интерфейс открыт в сеть.
SCADA_API_TOKEN=

# Адрес устройства — подставляется в configs/config.yaml (${PLC_HOST:-localhost})
PLC_HOST=localhost
PLC_PORT=5020

# Путь к конфигурации установки
SCADA_CONFIG=configs/config.yaml

# 1 — принудительно использовать Python-реализацию вместо C++ ядра
SCADA_FORCE_PYTHON_CORE=0

LOG_LEVEL=INFO
